# Person 2 worker — copy to .env and fill locally.
# NEVER commit a real .env. NEVER put secrets in git or chat logs.

PORT=8787

# Keep mock until LiveKit + Presage credentials are configured (Phase 2+).
# mock = offline/session lifecycle without calling SmartSpectra
# live = requires SMARTSPECTRA_API_KEY and uses official Node SDK custom input
PRESAGE_MODE=mock

# --- Required for real LiveKit sessions (Phase 2+) ---
# Get these from your LiveKit Cloud (or self-hosted) project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Required when PRESAGE_MODE=live (Phase 3+) ---
# API key from https://physiology.presagetech.com (Presage Developer Portal)
SMARTSPECTRA_API_KEY=

# --- Optional Person 3 forward (Phase 6) ---
PERSON3_MEASUREMENT_URL=
PERSON3_SERVICE_TOKEN=

# Seconds of measurement before auto-complete in live mode (breathing window ~30s)
# Breathing often needs ~30s+; keep >= 35 so both vitals can fill.
MIN_MEASUREMENT_SECONDS=45
