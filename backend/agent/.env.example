# Copy to .env.local and fill secrets locally. Never commit real keys.
# cp .env.example .env.local && chmod 600 .env.local

# LiveKit (required for Chert worker / FaceTime bridge)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Chert named agent (must match chert_worker + `chert dev --agent`)
AGENT_NAME=vitalink-caregiver

# probe = audio beeps only. conversation = Gemini LLM + ElevenLabs STT/TTS.
VITALINK_MODE=probe

# Direct-room fallback identities (agent.py / open-source connector)
LIVEKIT_ROOM=vitalink-demo
AGENT_IDENTITY=vitalink-agent
CONNECTOR_IDENTITY=vitalink-facetime

# Conversation providers (required when VITALINK_MODE=conversation)
GOOGLE_API_KEY=
ELEVEN_API_KEY=
# Premade Sarah (free-tier API). Mature, Reassuring, Confident.
ELEVEN_VOICE_ID=EXAVITQu4vr4xnSDxMaL
GEMINI_MODEL=gemini-3.5-flash-lite
ELEVEN_TTS_MODEL=eleven_turbo_v2_5

# Synthetic demo patient for teammate integration
PATIENT_ID=synthetic-demo-patient
