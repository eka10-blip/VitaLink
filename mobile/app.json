{
  "expo": {
    "name": "VitaLink",
    "slug": "vitalink-person4",
    "scheme": "vitalink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leelasowjanya.vitalink",
      "infoPlist": {
        "NSCameraUsageDescription": "VitaLink uses the camera so Presage can estimate pulse and breathing during check-in.",
        "NSMicrophoneUsageDescription": "Microphone access is reserved for the voice check-in teammate integration."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F5F8F7"
      },
      "package": "com.leelasowjanya.vitalink"
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "platforms": [
      "ios"
    ]
  }
}
