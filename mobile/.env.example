# Keep unset to use safe synthetic demo data.
# Only enable when a teammate implements the endpoints in INTEGRATION_CONTRACT.md.
EXPO_PUBLIC_VITALINK_API_URL=

# Person 2 Presage worker — must be a public HTTPS URL (cloud deploy).
# Example: https://vitalink-presage-worker-production.up.railway.app
# Do NOT use localhost / LAN / USB IPs for device builds.
EXPO_PUBLIC_PRESAGE_WORKER_URL=

# Do NOT put passwords, Gemini keys, service-role keys, LiveKit API secrets,
# or Presage API keys in EXPO_PUBLIC_*.
